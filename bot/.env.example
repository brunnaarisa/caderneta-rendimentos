# === Token do bot Telegram ===
# Pegue com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# === Chave da API Anthropic (Claude) ===
# Crie em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# === Configurações do bot ===
# Consultas grátis por dia para usuários não-premium
FREE_DAILY_LIMIT=3

# Preço do premium em reais (exibição)
PREMIUM_PRICE=14.90

# === Mercado Pago (Pix) — OPCIONAL ===
# Para receber pagamentos via Pix automaticamente
# Crie em: https://www.mercadopago.com.br/developers
# Vá em: Suas integrações > Criar aplicação > Credenciais de Produção
MERCADOPAGO_ACCESS_TOKEN=

# === Configurações opcionais ===
# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Caminho do banco de dados SQLite
DATABASE_PATH=data/financas_ia.db
